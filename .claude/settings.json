{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**/*.ts)",
      "Read(**/*.tsx)",
      "Read(**/*.js)",
      "Read(**/*.jsx)",
      "Read(**/*.json)",
      "Read(**/*.css)",
      "Read(**/*.scss)",
      "Read(**/*.html)",
      "Read(**/*.svg)",
      "Read(**/*.md)",
      "Read(**/*.yaml)",
      "Read(**/*.yml)",
      "Read(**/*.txt)",
      "Read(**/*.lock)",
      "Read(**/.env.example)",
      "Read(**/.env.local.example)",
      "Read(**/.gitignore)",
      "Read(**/.gitattributes)",
      "Read(**/*.config.js)",
      "Read(**/*.config.ts)",
      "Read(**/*.config.mjs)",
      "Read(**/*.config.json)",
      "Read(**/README*)",
      "Read(**/LICENSE*)",
      "Read(**/.editorconfig)",
      "Read(**/.prettierrc*)",
      "Read(**/eslint*)",
      "Read(**/next-env.d.ts)",

      "Write(**/*.ts)",
      "Write(**/*.tsx)",
      "Write(**/*.js)",
      "Write(**/*.jsx)",
      "Write(**/*.css)",
      "Write(**/*.md)",
      "Write(**/.gitignore)",

      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "Edit(**/*.js)",
      "Edit(**/*.jsx)",
      "Edit(**/*.json)",
      "Edit(**/*.css)",
      "Edit(**/*.scss)",
      "Edit(**/*.html)",
      "Edit(**/*.md)",
      "Edit(**/*.yaml)",
      "Edit(**/*.yml)",
      "Edit(**/*.txt)",
      "Edit(**/*.config.js)",
      "Edit(**/*.config.ts)",
      "Edit(**/*.config.mjs)",
      "Edit(**/*.config.json)",
      "Edit(**/.editorconfig)",
      "Edit(**/.prettierrc*)",

      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:typescript-eslint.io)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:prettier.io)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:expressjs.com)",
      "WebFetch(domain:mongoosejs.com)",
      "WebFetch(domain:zod.dev)",

      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git init)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(openspec:*)"
    ],
    "ask": ["Bash(git push:*)"],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/config/credentials.json)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/build/**)",
      "Read(**/dist/**)",
      "Read(**/node_modules/**)",
      "Read(**/.git/**)",
      "Read(~/.bashrc)",
      "Read(~/.zshrc)",
      "Read(~/.profile)",
      "Read(/etc/**)",
      "Read(/var/**)",
      "Read(/usr/**)",

      "Edit(**/.git/**)",
      "Edit(**/secrets/**)",
      "Edit(**/config/credentials.json)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Edit(/etc/**)",
      "Edit(/var/**)",
      "Edit(/usr/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",

      "WebFetch(domain:*.local)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:192.168.*)",
      "WebFetch(domain:10.*)",
      "WebFetch(domain:172.16.*)",

      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(mount:*)",
      "Bash(umount:*)",
      "Bash(systemctl:*)",
      "Bash(service:*)",
      "Bash(kill:*)",
      "Bash(killall:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": ["git", "npm", "npx", "node"],
    "network": {
      "allowLocalBinding": true,
      "allowOutbound": false
    }
  },
  "env": {
    "NODE_ENV": "development"
  }
}
