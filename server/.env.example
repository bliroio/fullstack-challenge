# Port the Express server listens on
PORT=3000

# MongoDB connection string.
#
# Local development via docker-compose (recommended — see ../docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017/bliro-challenge
#
# MongoDB Atlas alternatives:
#   1. SRV format (shorter, requires DNS SRV support on your network):
#      mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DB?retryWrites=true&w=majority
#   2. Standard format (skips DNS SRV lookup, works everywhere):
#      mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/DB?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority
#      In Atlas: Connect -> Drivers -> Driver version "Node.js 2.2.12 or later".

# Optional: public base URL of the API (used in Swagger docs and startup log).
# Defaults to http://localhost:${PORT}. Set this in production.
# API_BASE_URL=https://api.example.com

# Optional: comma-separated list of allowed CORS origins.
# Defaults to allowing all origins. Set this in production.
# CORS_ORIGIN=https://app.example.com
