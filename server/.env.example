# MongoDB connection string (required)
# Paste your personal MongoDB access key here
MONGODB_URI=[MY_PERSONAL_ACCESS_KEY]

# Server port (optional, default: 3000)
PORT=3000

# Environment: "development", "test", or "production"
# The seed script refuses to run when NODE_ENV=production
NODE_ENV=development

# Frontend origin for CORS (optional, default: http://localhost:3001)
FRONTEND_URL=http://localhost:3001

# Seed script: seeding is disabled by default — set to "true" to allow
# SEED_DB=true
